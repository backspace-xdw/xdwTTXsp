# ========================================
# xdwTTXsp GPS车辆监控平台 - 后端环境配置
# 复制此文件为 .env 并修改为实际配置
# ========================================

# 服务端口
PORT=8081
NODE_ENV=production

# JWT 密钥 (生产环境请修改为强随机字符串，至少32位)
JWT_SECRET=change_this_to_a_strong_random_secret_key_min_32_chars
JWT_EXPIRES_IN=24h

# 数据库配置 (MySQL)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=gps_platform
DB_USER=root
DB_PASSWORD=your_mysql_password
# 数据库连接池
DB_POOL_MAX=20
DB_POOL_MIN=2

# Redis 缓存 (可选，注释掉则使用内存缓存)
# REDIS_HOST=localhost
# REDIS_PORT=6379
# REDIS_PASSWORD=
# REDIS_URL=redis://localhost:6379

# JT808 设备通信端口 (需在防火墙开放)
JT808_PORT=8808
JT808_HEARTBEAT_TIMEOUT=180000

# JT1078 视频流端口 (需在防火墙开放)
JT1078_PORT=1078

# 前端访问地址 (CORS 白名单，填写实际域名或IP)
# 例: http://192.168.1.100 或 http://your-domain.com
CORS_ORIGIN=*

# GPS 模拟数据 (生产环境设为 false)
ENABLE_GPS_SIMULATION=false

# 批处理配置
BATCH_GPS_BUFFER_SIZE=500
BATCH_GPS_FLUSH_INTERVAL=2000
BATCH_REALTIME_BUFFER_SIZE=200
BATCH_REALTIME_FLUSH_INTERVAL=1000

# 数据保留天数
DATA_RETENTION_DAYS=90
